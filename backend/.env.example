# Kato Dashboard Backend Environment Variables

# Server Configuration
PORT=3001

# Database
DATABASE_URL=./data/dashboard.db

# Brave Search API
# Get your API key from: https://brave.com/search/api/
# Free tier: 1 query/second, 2000 queries/month
BRAVE_API_KEY=your_brave_api_key_here

# GitHub Webhook Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use this secret when configuring webhooks in GitHub repository settings
GITHUB_WEBHOOK_SECRET=d8abedeb62c3d76804d8b51b5e64ce7eceea361b5483ddcd8cc466e0e7037194

# Optional: WebSocket configuration
WS_HEARTBEAT_INTERVAL=30000

# Optional: Logging
LOG_LEVEL=info
