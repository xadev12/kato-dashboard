{
  "name": "kato-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx backend/server.ts",
    "server:dev": "tsx watch backend/server.ts",
    "db:seed": "cd backend && npx tsx seed.ts",
    "db:sync": "cd backend && npx tsx sync.ts",
    "start:all": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "backend:start": "npm run server",
    "backend:dev": "npm run server:dev",
    "collect:github": "cd backend && npx tsx collectors/github.ts",
    "collect:gateway": "cd backend && npx tsx collectors/gateway.ts",
    "collect:sessions": "cd backend && npx tsx collectors/sessions.ts",
    "collect:memory": "cd backend && npx tsx collectors/memory.ts",
    "collect:all": "cd backend && npm run collect:all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.2",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
